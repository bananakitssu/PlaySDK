{
  "name": "bananakitssu-playsdk",
  "version": "0.1.0",
  "description": "Banana Play game SDK for saved data, player presence, and WebRTC packet servers.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rserver": {
      "types": "./dist/rserver.d.ts",
      "import": "./dist/rserver.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "werift": "^0.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
